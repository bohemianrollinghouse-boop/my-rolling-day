# Copier en .env.ios (non versionné) — utilisé par `npm run archive:ios`.
# Clé API à créer sur https://appstoreconnect.apple.com/access/integrations/api
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_KEY_PATH=/Users/<toi>/private_keys/AuthKey_XXXXXXXXXX.p8

# Optionnel : override du Team ID (défaut J76SQYZMQX, celui du projet Xcode)
# IOS_TEAM_ID=J76SQYZMQX
