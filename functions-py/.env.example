# Copier en functions-py/.env (non versionné) — chargé par Firebase au deploy et en émulateur.
# Clé API : https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=

# Modèle d'analyse. Défaut : claude-sonnet-5 (recommandé — la saisonnalité au mois
# près demande du raisonnement). Pour comparer le coût : claude-haiku-4-5.
# ANTHROPIC_MODEL=claude-sonnet-5
