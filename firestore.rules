rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper : l'utilisateur est bien authentifié
    function isAuth() {
      return request.auth != null;
    }

    // Helper : l'utilisateur fait partie d'une famille (a un doc member)
    function isFamilyMember(familyId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    // Helper : l'utilisateur est admin de la famille
    function isFamilyAdmin(familyId) {
      return isFamilyMember(familyId) &&
        get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;

      match /messagingTokens/{tokenId} {
        allow read, write: if isAuth() && request.auth.uid == uid;
      }
    }

    // Champs du statut premium : ecrits UNIQUEMENT par le webhook RevenueCat,
    // via l'Admin SDK qui contourne ces regles (functions/index.js).
    //
    // Sans ce verrou, l'abonnement ne vaut rien : `allow write: if
    // isFamilyMember` laissait n'importe quel membre poser `premium: true` sur
    // son propre foyer depuis un client modifie.
    function touchePremium() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['premium', 'premiumSource', 'premiumProductId',
                 'premiumExpiresAt', 'premiumLastEvent', 'premiumUpdatedAt']);
    }

    // ── Catalogue de recettes ──────────────────────────────────────────────
    // Collection globale alimentee par la console d'administration, via
    // l'Admin SDK qui contourne ces regles. Lisible par tout compte connecte —
    // c'est le catalogue propose aux foyers — et ecrite par personne d'autre
    // que le serveur.
    match /recipes/{recipeId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Families ───────────────────────────────────────────────────────────
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      // create : un foyer neuf n'a pas de champ premium a proteger, et
      // `resource` n'existe pas encore — d'ou la separation d'avec update.
      allow create: if isFamilyMember(familyId)
        && !request.resource.data.keys().hasAny(['premium', 'premiumSource',
             'premiumProductId', 'premiumExpiresAt', 'premiumLastEvent', 'premiumUpdatedAt']);
      allow update: if isFamilyMember(familyId) && !touchePremium();
      allow delete: if isFamilyMember(familyId);

      match /members/{uid} {
        allow read: if isFamilyMember(familyId);
        // Chacun écrit son propre doc (rejoindre/quitter) ; un admin peut aussi
        // supprimer le doc d'un autre membre (retrait d'un membre du foyer).
        allow write: if isAuth() && (request.auth.uid == uid || isFamilyAdmin(familyId));

        // Tokens FCM par appareil — chaque user écrit uniquement ses propres devices
        match /devices/{deviceId} {
          allow read, write: if isAuth() && request.auth.uid == uid;
        }
      }

      match /people/{personId} {
        allow read, write: if isFamilyMember(familyId);
      }

      match /planner/{document=**} {
        allow read, write: if isFamilyMember(familyId);
      }

      match /invitations/{invitationId} {
        allow read: if isAuth();
        allow write: if isFamilyMember(familyId);
      }

      // Rappels reportes depuis la popup 8a (« Plus tard »). Le document
      // n'existe que tant que le rappel est en attente : la Cloud Function le
      // supprime apres l'envoi.
      //
      // `uid` est l'auteur du report, `scope` son perimetre :
      //
      //   person    — la tache est assignee : le report ne repart qu'a ses
      //               assignes, et l'auteur doit en faire partie. Sans cette
      //               condition, un membre programmerait des notifications sur
      //               le telephone d'un autre.
      //   household — personne n'est assigne : le rappel est celui de la
      //               maison, le report vaut pour tout le monde, et seul un
      //               admin peut l'engager.
      //
      // Le bouton « Plus tard » masque cote client n'est qu'une commodite :
      // c'est ici que la permission est reellement tenue. Pas d'update : un
      // report ne se modifie pas, il se reprogramme.
      match /reminders/{reminderId} {
        allow read: if isFamilyMember(familyId);
        allow create: if isFamilyMember(familyId)
          && request.resource.data.uid == request.auth.uid
          && (
               (request.resource.data.scope == 'person'
                 && request.auth.uid in request.resource.data.uids)
               || (request.resource.data.scope == 'household'
                 && isFamilyAdmin(familyId))
             );
        allow delete: if isFamilyMember(familyId)
          && resource.data.uid == request.auth.uid;
        allow update: if false;
      }

      match /serverNotificationLog/{logId} {
        allow read: if isFamilyMember(familyId);
        allow write: if false; // écrit uniquement par Cloud Functions
      }

      match /joinEvents/{eventId} {
        allow read: if isFamilyMember(familyId);
        // Le nouvel entrant écrit son propre joinEvent (son UID doit correspondre)
        // après que le batch d'acceptation l'a rendu membre. La Cloud Function
        // onMemberJoined écoute cette création et notifie les autres membres.
        allow create: if isFamilyMember(familyId)
          && request.resource.data.joinerUid == request.auth.uid;
      }
    }

    // ── Mail (extension "Trigger Email from Firestore") ──────────────────────
    // Écrit uniquement par la Cloud Function requestPasswordReset (Admin SDK,
    // qui contourne les règles) et lu par l'extension elle-même (idem).
    match /mail/{mailId} {
      allow read, write: if false;
    }
  }
}
