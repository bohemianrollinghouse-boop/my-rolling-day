{
  "name": "my-rolling-day",
  "version": "1.0.0",
  "build": "1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ./scripts/generate-build-info.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "build:ios": "npm run build && npx cap sync ios && npx cap open ios",
    "build:ios:fast": "npm run build && npx cap copy ios && npx cap open ios",
    "build:ios:clean": "npm run build && npx cap sync ios && cd ios/App && pod deintegrate && pod install && cd ../.. && npx cap open ios",
    "build:android": "npm run build && npx cap sync android && cd android && ./gradlew clean && ./gradlew build --refresh-dependencies && cd .. && npx cap open android",
    "build:android:fast": "npm run build && npx cap copy android && npx cap open android",
    "device:ios": "npm run build && npx cap run ios --external",
    "device:android": "npm run build && npx cap run android --external",
    "icons": "node ./scripts/generate-app-icons.mjs",
    "releases": "node ./scripts/bump-version.mjs",
    "prepare:releases": "node ./scripts/prepare-ios-release.mjs && node ./scripts/prepare-android-release.mjs",
    "prepare:ios:release": "node ./scripts/prepare-ios-release.mjs",
    "prepare:android:release": "node ./scripts/prepare-android-release.mjs",
    "archive:ios": "node ./scripts/archive-ios.mjs",
    "upload:android": "node ./scripts/upload-android.mjs",
    "emulators:start": "firebase emulators:start --import ./.firebase-emulator-data --export-on-exit ./.firebase-emulator-data",
    "free-emulators-ports": "bash ./scripts/free-emulators-ports.sh",
    "deploy": "npm run build && firebase deploy",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "test": "node --test --experimental-test-isolation=none tests/unit.test.js tests/e2e.test.js",
    "test:unit": "node --test --experimental-test-isolation=none tests/unit.test.js",
    "test:e2e": "node --test --experimental-test-isolation=none tests/e2e.test.js",
    "test:standalone": "node --test --experimental-test-isolation=none tests/e2e/auth.standalone.test.js",
    "test:release": "npm run test && npm run build",
    "deploy:functions:recipes": "firebase deploy --only functions:recipes"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/speech-recognition": "^7.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/authentication": "^8.5.0",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "@revenuecat/purchases-capacitor": "^13.4.2",
    "firebase": "^12.18.0",
    "htm": "^3.1.1",
    "ionicons": "^8.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  }
}
