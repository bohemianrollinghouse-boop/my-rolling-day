.claude/
server.out.log
server.err.log
node_modules/
.env
.env.ios
.env.android

# Cle d'API Notion. ATTENTION : le motif `.env` ci-dessus ne matche QUE le
# fichier nomme exactement `.env` — il ne couvre pas `.notion.env`. Ce depot
# est public, donc ce motif explicite est la seule chose qui empeche la cle
# de partir en clair. Ne pas le retirer.
.notion.env
*.notion.env

# Fonctions Python (import de recettes)
functions-py/.env
functions-py/venv/
__pycache__/

# Build output
dist/
src/assets/build-info.json

# Build de l'application servi aux tests E2E (regénéré à chaque run)
tests/.e2e-dist/

# Captures d'écran de comparaison visuelle (migration Ionic).
# `baseline/` est la référence et reste versionnée ; les captures par phase
# sont régénérables et pèsent ~6 Mo chacune — hors dépôt.
tests/screenshots/*/
!tests/screenshots/baseline/

# Signature Android (identifiants + keystore hors dépôt)
android/keystore.properties
*.jks
*.p8

# Émulateurs Firebase
.firebase-emulator-data/
.tmp-emulators.log
*-debug.log

# Capacitor Android build artifacts
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Capacitor iOS build artifacts
ios/App/Pods/
ios/.xcode.env.local

# Android Studio / IntelliJ project files (machine-specific)
android/.idea/
.idea/

# Firebase CLI local cache
.firebase/

# Fichiers de metadonnees Finder (macOS) — le projet se developpe sur Mac
# et Windows, ceux-ci n ont rien a faire dans le depot.
.DS_Store
