# Copier en .env.android (non versionné) — utilisé par `npm run upload:android`.
# Compte de service avec le rôle "Android Publisher" côté Google Play Console.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=/Users/<toi>/keys/my-rolling-day-play.json

# Optionnels
# GOOGLE_PLAY_PACKAGE_NAME=fr.myrollingday.app
# GOOGLE_PLAY_TRACK=internal   # internal | alpha | beta | production
